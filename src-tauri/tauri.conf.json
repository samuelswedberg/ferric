{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ferric",
  "version": "0.1.0",
  "identifier": "dev.ferric.app",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../ui",
    "beforeBuildCommand": "npm run build --prefix ../ui",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ferric",
        "width": 360,
        "height": 520,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/32x32.png",
      "showMenuOnLeftClick": false,
      "tooltip": "Ferric"
    },
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/art/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
